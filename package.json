{
  "name": "leaf-reader",
  "version": "0.1.13",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:web": "node tools/run_browser_tests.cjs",
    "test:formats": "node tools/run_browser_tests.cjs formats",
    "preview": "python3 tools/dev_server.py",
    "check:resources": "python3 tools/check_resources.py",
    "check:release": "python3 tools/check_release.py",
    "prepare:source": "python3 tools/export_source.py",
    "check:speech": "python3 tools/check_speech_source.py",
    "build:speech": "node tools/build_speech_source.cjs",
    "test:speech": "node tests/speech-source.cjs",
    "test:speech-native": "python3 tools/test_speech_native.py"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "terser": "5.51.2"
  }
}
